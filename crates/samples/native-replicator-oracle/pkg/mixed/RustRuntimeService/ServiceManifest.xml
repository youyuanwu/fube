<?xml version="1.0" encoding="utf-8"?>
<ServiceManifest Name="RustRuntimeService" Version="1.1"
 xmlns="http://schemas.microsoft.com/2011/01/fabric">
  <ServiceTypes>
    <StatelessServiceType ServiceTypeName="RustRuntimeType" UseImplicitHost="false" />
    <StatefulServiceType ServiceTypeName="RustStatefulRuntimeType" HasPersistedState="false" />
  </ServiceTypes>
  <CodePackage Name="Code" Version="1.1">
    <EntryPoint>
      <ExeHost>
        <Program>launch-mixed.py</Program>
        <WorkingFolder>CodePackage</WorkingFolder>
        <ConsoleRedirection FileRetentionCount="5" FileMaxSizeInKb="1024" />
      </ExeHost>
    </EntryPoint>
  </CodePackage>
  <ConfigPackage Name="Config" Version="1.0" />
  <DataPackage Name="Data" Version="1.0" />
  <Resources>
    <Endpoints>
      <Endpoint Name="Rpc" Protocol="http" Type="Input" />
    </Endpoints>
  </Resources>
</ServiceManifest>
